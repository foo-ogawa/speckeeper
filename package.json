{
  "name": "speckeeper",
  "version": "0.19.2",
  "description": "TypeScript-first specification validation framework with external SSOT integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dsl": {
      "types": "./dist/dsl/index.d.ts",
      "import": "./dist/dsl/index.js",
      "default": "./dist/dsl/index.js"
    },
    "./insight-provider": {
      "types": "./dist/external/insight-provider.d.ts",
      "import": "./dist/external/insight-provider.js",
      "default": "./dist/external/insight-provider.js"
    }
  },
  "bin": {
    "speckeeper": "dist/speckeeper.bundle.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs",
    "specs",
    "cli-contract.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "bundle": "node esbuild.bundle.mjs",
    "build:docs": "npm run build && embedoc build",
    "dev": "tsup --watch",
    "lint": "eslint",
    "lint:design": "eslint design/",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run bundle && npm run test:run",
    "docs": "embedoc build",
    "docs:watch": "embedoc watch",
    "dsl:generate": "npx agent-runtime generate --config dsl/agent-runtime.config.yaml",
    "contract:validate": "npx cli-contracts validate",
    "contract:generate": "npx cli-contracts generate",
    "ci": "npm run ci:validate && npm run ci:generate && npm run ci:verify",
    "ci:validate": "npm run typecheck && npm run lint && npm run lint:design && npm run build && npm run bundle && npx speckeeper lint && npm run test:run",
    "ci:generate": "embedoc build",
    "ci:verify": "npx speckeeper check && npx speckeeper check --coverage",
    "test:ci": "vitest run",
    "test:bundle": "vitest run --config vitest.bundle.config.ts"
  },
  "keywords": [
    "requirements",
    "design",
    "documentation",
    "markdown",
    "mermaid",
    "typescript",
    "dsl",
    "architecture",
    "c4-model"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "glob": "^14.0.6",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@aaac/runtime": "^0.2.7",
    "@anthropic-ai/claude-agent-sdk": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@aaac/runtime": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aaac/runtime": "^0.2.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/node-sql-parser": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "agent-contracts": "^0.35.9",
    "agent-contracts-runtime": "^0.36.15",
    "chalk": "^6.0.1",
    "cli-contracts": "^0.35.0",
    "commander": "^15.1.0",
    "embedoc": "^0.14.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "node-sql-parser": "^5.4.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "embedoc": {
      "glob": "^14.0.6"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    }
  }
}
